  "drivers": [
    {
      "name": {
        "en": "Zeekr",
        "nl": "Zeekr"
      },
      "class": "car",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "energy": {
        "electricCar": true
      },
      "capabilities": [
        "measure_battery",
        "zeekr_range",
        "ev_charging_state",
        "zeekr_charge_power",
        "locked",
        "zeekr_climate",
        "target_temperature",
        "measure_temperature",
        "measure_temperature.exterior",
        "alarm_contact.doors",
        "alarm_contact.trunk",
        "alarm_contact.windows",
        "zeekr_odometer",
        "zeekr_last_update"
      ],
      "capabilitiesOptions": {
        "measure_battery": {
          "title": {
            "en": "Battery",
            "nl": "Accu"
          }
        },
        "ev_charging_state": {
          "setable": false
        },
        "target_temperature": {
          "title": {
            "en": "Climate temperature",
            "nl": "Klimaattemperatuur"
          },
          "min": 16,
          "max": 28,
          "step": 0.5
        },
        "measure_temperature": {
          "title": {
            "en": "Interior temperature",
            "nl": "Binnentemperatuur"
