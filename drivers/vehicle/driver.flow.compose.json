        "en": "Start climate at [[temperature]] °C for [[duration]] minutes",
        "nl": "Start klimaat op [[temperature]] °C voor [[duration]] minuten"
      },
      "args": [
        { "name": "temperature", "type": "number", "min": 16, "max": 28, "step": 0.5, "placeholder": { "en": "21" } },
        { "name": "duration", "type": "number", "min": 1, "max": 30, "step": 1, "placeholder": { "en": "15" } }
      ]
    },
    {
      "id": "climate_off",
      "title": { "en": "Stop climate", "nl": "Stop klimaat" }
    },
