    {
      "id": "battery_above",
      "title": { "en": "Battery is !{{above|below}} …%", "nl": "Accu is !{{boven|onder}} …%" },
      "titleFormatted": { "en": "Battery is !{{above|below}} [[percent]]%", "nl": "Accu is !{{boven|onder}} [[percent]]%" },
      "args": [
        { "name": "percent", "type": "range", "min": 0, "max": 100, "step": 1, "label": "%", "labelDecimals": 0 }
      ]
    },
    {
      "id": "range_above",
      "title": { "en": "Range is !{{above|below}} … km", "nl": "Actieradius is !{{boven|onder}} … km" },
      "titleFormatted": { "en": "Range is !{{above|below}} [[km]] km", "nl": "Actieradius is !{{boven|onder}} [[km]] km" },
      "args": [
        { "name": "km", "type": "number", "min": 0, "max": 1500, "step": 1, "placeholder": { "en": "100" } }
      ]
    }
  ],
  "actions": [
    {
      "id": "climate_on",
      "title": { "en": "Start climate (preheat / cool)", "nl": "Start klimaat (voorverwarmen / koelen)" },
