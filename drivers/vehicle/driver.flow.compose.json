      ]
    },
    {
      "id": "status_updated",
      "title": { "en": "Status updated", "nl": "Status is bijgewerkt" },
      "tokens": [
        { "name": "battery", "type": "number", "title": { "en": "Battery %", "nl": "Accu %" }, "example": 64 },
        { "name": "range", "type": "number", "title": { "en": "Range (km)", "nl": "Actieradius (km)" }, "example": 312 },
