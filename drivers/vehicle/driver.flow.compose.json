        { "name": "error", "type": "string", "title": { "en": "Error", "nl": "Foutmelding" }, "example": "Session expired" }
      ]
    }
  ],
  "conditions": [
    {
      "id": "is_charging",
      "title": { "en": "Is !{{|not}} charging", "nl": "Laadt !{{|niet}}" }
    },
    {
      "id": "is_plugged_in",
      "title": { "en": "Charging cable is !{{|not}} connected", "nl": "Laadkabel is !{{|niet}} aangesloten" }
