        { "name": "longitude", "type": "number", "title": { "en": "Longitude", "nl": "Lengtegraad" }, "example": 4.89 }
      ]
    },
    {
      "id": "command_failed",
      "title": { "en": "A command failed", "nl": "Een commando is mislukt" },
